[
  {
    "type": "function",
    "function": {
      "name": "get_workout_state",
      "description": "Read pinned full workout state, profile and decisions. Optional autoregulation requests deterministic server calculation; never infer RIR or equipment.",
      "parameters": {
        "type": "object",
        "properties": {
          "autoregulation": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string",
                "enum": [
                  "PRESERVE_PLAN",
                  "STRENGTH",
                  "HYPERTROPHY"
                ]
              },
              "exercise_id": {
                "type": "string",
                "format": "uuid"
              },
              "available_weights_kg": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "observed_rest_seconds": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "find_exercises",
      "description": "Search authorized catalogue. Includes latest completed workout sets. Equipment filter matches exercises requiring all supplied equipment IDs; an empty filter is unrestricted. Requirements do not prove present availability. Empty history means unknown. Use returned UUIDs.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "equipment_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "muscle_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "muscle_groups": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_exercise_history",
      "description": "Read completed sets from latest three finished workouts owned by this user.",
      "parameters": {
        "type": "object",
        "properties": {
          "exercise_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "exercise_id"
        ],
        "additionalProperties": false
      }
    }
  },
