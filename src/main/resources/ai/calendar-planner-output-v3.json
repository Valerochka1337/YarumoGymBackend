{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProviderOutput",
  "$defs": {
    "ProviderOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "exercises"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "exercises": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": {
                "$ref": "#/$defs/ProviderExercise"
              }
            }
          }
        }
      }
    },
    "ProviderExercise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exerciseId",
        "restSeconds",
        "plannedSets"
      ],
      "properties": {
        "exerciseId": {
          "$ref": "#/$defs/Uuid"
        },
        "restSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 900
        },
        "plannedSets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/ProviderSet"
          }
        }
      }
    },
    "ProviderSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reps",
        "durationSec"
      ],
      "properties": {
        "reps": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100
        },
        "durationSec": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 7200
        }
      }
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
